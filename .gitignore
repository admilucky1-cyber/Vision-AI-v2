# ============================================================
# 🔥 VISION AI - APPLICATION-SPECIFIC IGNORES
# ============================================================

# 1. ENVIRONMENT VARIABLES (CRITICAL)
.env
.env.local
.env.production
.env.development
*.env
*.env.*

# 2. UPLOADED FILES (USER DATA)
uploads/
uploads/**/*
!uploads/.gitkeep

# 3. VECTOR DATABASE & EMBEDDINGS
chroma_db/
chroma_db/**/*
!chroma_db/.gitkeep

# 4. DOWNLOADS & CACHE
downloads/
downloads/**/*
!downloads/.gitkeep
cache/
cache/**/*
!cache/.gitkeep

# 5. LOGS
logs/
logs/**/*
!logs/.gitkeep
app.log
*.log

# 6. SEARCH & LEARNING DATABASES
search_cache.json
advanced_learning.json
knowledge_graph.json
update_history.json

# 7. TEMPORARY FILES
*.tmp
*.temp
*.pid

# ============================================================
# 🔥 SECURITY SAFETY NET (SENSITIVE FILES)
# ============================================================

# 8. DEPLOYMENT ARTIFACTS (DO NOT COMMIT)
.deploy/
.DS_Store
*.secret
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# 9. BACKUP FILES (AVOID ACCIDENTAL COMMITS)
*.bak
*.backup
*.old
*.orig

# 10. SYSTEM FILES (MAC / WINDOWS / LINUX)
.DS_Store
Thumbs.db
desktop.ini
*.lnk
*.dll
*.exe
*.msi

